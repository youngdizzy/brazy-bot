# Telegram
TELEGRAM_BOT_TOKEN=
ANTHROPIC_API_KEY=

# Solana / Jupiter — LIVE OFF BY DEFAULT
COPY_LIVE_ENABLED=false
SOL_LIVE_TRADING=false
SOL_REQUIRE_ORDER_VALIDATION=true
SOL_REQUIRE_SIMULATION=true
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_KEY=
JUPITER_API_BASE=https://api.jup.ag/swap/v1
JUPITER_LITE_BASE=https://lite-api.jup.ag/swap/v1

# Automation (monitoring only unless live enabled)
AUTO_COPY_MONITOR=false
AUTO_COPY_INTERVAL_SEC=45
AUTO_SCAN_DISCOVER=false

# Conservative risk (do not raise without explicit intent)
SOL_MAX_BUY=0.001
SOL_MAX_DAILY_LOSS=0.003
SOL_MAX_OPEN_POSITIONS=1
COPY_MAX_SNIPE_SOL=0.05
MIN_RR=1.5
